{
  "expo": {
    "name": "Happie",
    "slug": "happie",
    "scheme": "happie",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5EFE2"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.drinkhappie.app"
    },
    "android": {
      "package": "com.drinkhappie.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5EFE2"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": { "typedRoutes": true }
  }
}
